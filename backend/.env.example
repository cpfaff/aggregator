# Backend-specific environment variables
# Copy this file to .env and adjust values as needed

# Database Configuration
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/dbname
SYNC_DATABASE_URL=postgresql://user:password@localhost:5432/dbname

# Security
# IMPORTANT: Generate a secure random key for production!
# You can use: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace_with_your_secure_random_key

# API Configuration
ACCESS_TOKEN_EXPIRE_MINUTES=30
LOG_LEVEL=INFO
# Comma-separated list of allowed CORS origins
# Development:
ALLOWED_ORIGINS=http://localhost,http://localhost:3000,http://localhost:5173,http://localhost:80,http://localhost:443,https://localhost,https://localhost:443
# Production example:
# ALLOWED_ORIGINS=https://aggregator.gfbio.org,https://dmp.gfbio.org

# Rate Limiting
# Format: number/timeunit (e.g., 5/minute, 100/hour, 1000/day)
LOGIN_RATE_LIMIT=5/minute
HARVEST_RATE_LIMIT=30/hour

# Celery Worker Configuration
# CPU percentage for validation worker (default: 75)
VALIDATOR_CPU_PERCENT=75
# Concurrency for statistics worker (default: auto, which uses CPU count)
STATS_WORKER_CONCURRENCY=auto
