# Frontend-specific environment variables
# Copy this file to .env and adjust values as needed

# API Configuration
# ----------------
# For Traefik setup with the new API structure:
# - Leave this empty since we include '/api' in API_VERSION in apiUtils.js
# - The frontend will construct URLs like: API_BASE + API_VERSION + endpoint
#   where API_VERSION is now '/api/v1'
#
# For direct backend access during development:
# - Set this to the full URL of your backend, e.g., 'http://localhost:8000'
#   The frontend will construct URLs like: 'http://localhost:8000/api/v1/endpoint'
REACT_APP_API_URL=
